{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Risk Rationale Record",
  "type": "object",
  "required": ["risk_id", "assessment_id", "finding_ids", "rationale", "analyst_review"],
  "properties": {
    "risk_id": {"type": "string", "pattern": "^R-[0-9]{4,}$"},
    "assessment_id": {"type": "string"},
    "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rationale": {
      "type": "object",
      "properties": {
        "attacker_access": {"type": ["string", "null"]},
        "exploitability": {"type": ["string", "null"]},
        "affected_asset": {"type": ["string", "null"]},
        "trust_boundary_crossed": {"type": ["boolean", "null"]},
        "impact": {"type": ["string", "null"]}
      }
    },
    "conclusion": {"type": ["string", "null"]},
    "analyst_review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "accepted", "modified", "rejected"]},
        "reviewer": {"type": ["string", "null"]}
      }
    }
  }
}
